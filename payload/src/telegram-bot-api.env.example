# Учётные данные приложения Telegram получают на https://my.telegram.org.
# Optional manual local Bot API configuration: /etc/gitreposted/telegram-bot-api.env.
# Не публикуйте заполненный файл.

TELEGRAM_API_ID=REPLACE_TELEGRAM_API_ID
TELEGRAM_API_HASH=REPLACE_TELEGRAM_API_HASH
TELEGRAM_LOCAL=1
TELEGRAM_WORK_DIR=/var/lib/telegram-bot-api
TELEGRAM_TEMP_DIR=/var/lib/telegram-bot-api/temp
TELEGRAM_VERBOSITY=2
