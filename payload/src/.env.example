# Legacy env-format example. The installer uses /etc/gitreposted/config.json instead.
# Set GITREPOSTED_ENV_FILE to exactly one private configuration file outside the webroot.
# Replace applicable REPLACE_* values; never commit real credentials.

# Сайт и HTTP-сервис.
HOST=127.0.0.1
PORT=3010
PUBLIC_BASE_URL=https://REPLACE_DOMAIN
ADMIN_API_KEY=REPLACE_STRONG_ADMIN_PASSWORD
# New installations use ADMIN_USERNAME and a scrypt hash, with an independent random
# 64-hex ADMIN_API_KEY for Bearer API access/session HMAC. Empty hash preserves legacy password login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Installer keeps workers paused until configuration/webhooks are complete; then restart with 1.
GITREPOSTED_WORKERS_ENABLED=1
# Message-ID idempotency: lease незавершённой обработки и срок хранения ID.
RELAY_EVENT_LEASE_SECONDS=300
RELAY_ID_TTL_DAYS=30
# Durable Telegram retry: 8 попыток с backoff 10..3600 секунд.
RELAY_RETRY_MAX_ATTEMPTS=8
RELAY_RETRY_BASE_SECONDS=10
RELAY_RETRY_MAX_SECONDS=3600
RELAY_RETRY_POLL_MS=1000
# Окно сборки полного Telegram-альбома перед первой попыткой.
TELEGRAM_ALBUM_SETTLE_MS=5000
# Конечные таймауты API и потоковой передачи медиа; зависший запрос не блокирует worker навсегда.
API_REQUEST_TIMEOUT_MS=45000
MEDIA_TRANSFER_TIMEOUT_MS=1800000
DEBUG_LOG_PATH=

# База данных.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=GitRePosted
DB_USER=gitreposted
DB_PASSWORD=REPLACE_DATABASE_PASSWORD

# Telegram-бот.
TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_RANDOM_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_BOT_URL=https://t.me/REPLACE_TELEGRAM_BOT_USERNAME
# Единый API-инстанс для webhook, сообщений и файлов: официальный либо локальный.
# Перед переходом на локальный сервер обязательно выполните процедуру logOut.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Локальный Bot API возвращает путь внутри контейнера. Bridge читает тот же файл
# по host-пути bind mount. Оба корня должны быть абсолютными.
TELEGRAM_BOT_API_CONTAINER_DATA_DIR=/var/lib/telegram-bot-api
TELEGRAM_BOT_API_HOST_DATA_DIR=/var/lib/gitreposted/telegram-bot-api
# 1 разрешает local Bot API принимать container-path временного файла.
TELEGRAM_LOCAL_FILE_MODE=0
TELEGRAM_RELAY_TEMP_SUBDIR=gitreposted-relay
PUBLIC_TELEGRAM_ENABLED=0

# МАКС-бот.
MAX_ENABLED=1
MAX_BOT_TOKEN=REPLACE_MAX_BOT_TOKEN
MAX_WEBHOOK_SECRET=REPLACE_RANDOM_MAX_WEBHOOK_SECRET
MAX_BOT_URL=https://max.ru/REPLACE_MAX_BOT_USERNAME
MAX_API_BASE_URL=https://platform-api2.max.ru
PUBLIC_MAX_ENABLED=0

# hCaptcha для входа администратора в /control/.
# Explicit 0 disables hCaptcha; an absent flag retains mandatory fail-closed behavior.
HCAPTCHA_ENABLED=1
HCAPTCHA_SITEKEY=REPLACE_HCAPTCHA_SITEKEY
HCAPTCHA_SECRET=REPLACE_HCAPTCHA_SECRET
